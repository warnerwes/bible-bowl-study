{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "reading-plan.schema.json",
  "type": "object",
  "required": [
    "id",
    "book",
    "bookSlug",
    "title",
    "days"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "book": {
      "type": "string"
    },
    "bookSlug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "day",
          "reference"
        ],
        "additionalProperties": false,
        "properties": {
          "day": {
            "type": "integer",
            "minimum": 1
          },
          "reference": {
            "type": "string"
          },
          "chapters": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "summary": {
            "type": "string"
          },
          "memoryVerse": {
            "type": "string"
          }
        }
      }
    }
  }
}
