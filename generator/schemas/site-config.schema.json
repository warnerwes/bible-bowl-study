{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "site-config.schema.json",
  "type": "object",
  "required": [
    "siteName",
    "repo",
    "defaultBook",
    "features"
  ],
  "additionalProperties": false,
  "properties": {
    "siteName": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "bibleVersion": {
      "type": "string"
    },
    "defaultBook": {
      "type": "string"
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primaryColor": {
          "type": "string"
        },
        "fontFamily": {
          "type": "string"
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memoryLabs": {
          "type": "boolean"
        },
        "masteryTrial": {
          "type": "boolean"
        },
        "reader": {
          "type": "boolean"
        },
        "updates": {
          "type": "boolean"
        }
      }
    },
    "navigation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "href"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "href": {
            "type": "string"
          }
        }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "copyright": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "href"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "href": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
