{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "reviewer-attestation.schema.json",
  "type": "object",
  "required": [
    "reviewer",
    "reviewedAt",
    "artifactId",
    "verdict"
  ],
  "additionalProperties": false,
  "properties": {
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewedAt": {
      "type": "string"
    },
    "artifactId": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "keep",
        "improve",
        "reject"
      ]
    },
    "comments": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    }
  }
}
