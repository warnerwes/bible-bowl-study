{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "research-artifact.schema.json",
  "type": "object",
  "required": [
    "id",
    "batchId",
    "book",
    "chapters",
    "tool",
    "importedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "batchId": {
      "type": "string"
    },
    "queueItemIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "book": {
      "type": "string"
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tool": {
      "type": "string"
    },
    "promptFile": {
      "type": "string"
    },
    "rawImportFile": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "sourceType",
          "rightsStatus",
          "verificationStatus"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "sourceType": {
            "enum": [
              "scripture",
              "patristic",
              "liturgical",
              "modern",
              "reference"
            ]
          },
          "rightsStatus": {
            "enum": [
              "public-domain",
              "summarize-only",
              "quote-allowed",
              "unknown"
            ]
          },
          "sourceClaim": {
            "type": "string"
          },
          "verificationStatus": {
            "enum": [
              "found",
              "verified",
              "rejected"
            ]
          }
        }
      }
    },
    "redFlags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "createdCandidateIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "importedAt": {
      "type": "string"
    }
  }
}
