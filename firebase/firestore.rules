rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidSuggestionCreate() {
      let keys = [
        'uid',
        'authorName',
        'kind',
        'book',
        'chapter',
        'reference',
        'text',
        'answerText',
        'url',
        'status',
        'createdAt'
      ];
      let hasUrl = request.resource.data.keys().hasAny(['url']);

      return request.resource.data.keys().hasAll(keys.removeAll(['url']))
        && request.resource.data.keys().hasOnly(hasUrl ? keys : keys.removeAll(['url']))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 40
        && request.resource.data.kind in ['question_seed', 'memory_hook', 'correction', 'surprising_fact', 'link']
        && request.resource.data.book in ['1 Corinthians', '2 Corinthians']
        && request.resource.data.chapter is int
        && request.resource.data.chapter >= 1
        && request.resource.data.chapter <= 16
        && request.resource.data.reference is string
        && request.resource.data.reference.size() >= 1
        && request.resource.data.reference.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.answerText is string
        && request.resource.data.answerText.size() <= 500
        && (
          request.resource.data.kind == 'link'
            ? hasUrl
              && request.resource.data.url is string
              && request.resource.data.url.size() >= 1
              && request.resource.data.url.size() <= 500
              && request.resource.data.url.matches('^https?://.*')
            : !hasUrl
        )
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
    }

    match /suggestions/{id} {
      allow create: if isSignedIn() && isValidSuggestionCreate();
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;

      match /reviewEvents/{eventId} {
        allow read, write: if false;
      }
    }
  }
}
